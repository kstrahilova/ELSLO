FROM golang:1.25.7-alpine

RUN apk add --no-cache curl unzip

ENV GOBIN=/root/.local/bin

RUN curl -LO https://github.com/protocolbuffers/protobuf/releases/download/v30.2/protoc-30.2-linux-x86_64.zip \
    && unzip protoc-30.2-linux-x86_64.zip -d /root/.local \
    && rm protoc-30.2-linux-x86_64.zip \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.10 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1

ENV GOBIN=
ENV PATH="/root/.local/bin:/go/bin:${PATH}"